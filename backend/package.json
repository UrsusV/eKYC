{
  "name": "ekyc-backend",
  "version": "1.0.0",
  "description": "Backend API for eKYC blockchain system",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:blockchain": "jest src/services/blockchain/__tests__",
    "test:blockchain:watch": "jest src/services/blockchain/__tests__ --watch",
    "test:blockchain:coverage": "jest src/services/blockchain/__tests__ --coverage",
    "test:models": "jest src/models/__tests__",
    "test:integration": "jest --testMatch='**/*.integration.test.js'",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:e2e": "./scripts/run-e2e-tests.sh",
    "test:e2e:blockchain": "./scripts/run-e2e-tests.sh --with-blockchain",
    "test:e2e:clean": "./scripts/run-e2e-tests.sh --clean-db",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "setup:test": "./scripts/setup-test-env.sh",
    "setup:test:blockchain": "./scripts/setup-test-env.sh --with-blockchain",
    "demo": "node ../scripts/demo-flow.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js"
  },
  "keywords": ["eKYC", "blockchain", "api", "express"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "mongoose": "^8.7.2",
    "redis": "^4.7.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.25.1",
    "ethers": "^6.13.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "jimp": "^1.6.0",
    "uuid": "^11.0.2",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "morgan": "^1.10.0",
    "joi": "^17.13.3",
    "crypto-js": "^4.2.0",
    "axios": "^1.7.7",
    "node-cron": "^3.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "express-mongo-sanitize": "^2.2.0",
    "xss": "^1.0.15",
    "hpp": "^0.2.3",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.0.1",
    "@types/jest": "^29.5.14",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
