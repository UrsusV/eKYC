{
  "name": "credential-registry-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for CredentialRegistry smart contract - Blockchain-based eKYC System",
  "main": "hardhat.config.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "hardhat test",
    "test:verbose": "hardhat test --verbose",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:coverage": "hardhat coverage",
    "test:specific": "hardhat test test/CredentialRegistry.test.js",
    "test:watch": "hardhat watch test",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "setup:issuers": "hardhat run scripts/setup-issuers.js",
    "setup:issuers:local": "hardhat run scripts/setup-issuers.js --network localhost",
    "setup:issuers:sepolia": "hardhat run scripts/setup-issuers.js --network sepolia",
    "test:deployed": "hardhat run scripts/test-deployed.js",
    "test:deployed:local": "hardhat run scripts/test-deployed.js --network localhost",
    "test:deployed:sepolia": "hardhat run scripts/test-deployed.js --network sepolia",
    "verify": "hardhat verify",
    "size": "hardhat size-contracts",
    "flatten": "hardhat flatten",
    "console": "hardhat console",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.js' 'scripts/**/*.js'",
    "analyze": "slither .",
    "prepare": "husky install || true"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "testing",
    "ekyc",
    "credential-registry",
    "bangladesh",
    "banking",
    "identity",
    "kyc",
    "solidity",
    "web3"
  ],
  "author": "eKYC System Development Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "chai": "^4.2.0",
    "dotenv": "^16.0.3",
    "ethers": "^6.4.0",
    "hardhat": "^2.19.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.8",
    "hardhat-watcher": "^2.5.0",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.1.0",
    "solhint": "^3.6.2",
    "solidity-coverage": "^0.8.0",
    "typechain": "^8.3.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/credential-registry"
  }
}
